# --- Required -------------------------------------------------------------
# PostgreSQL connection (Supabase DATABASE_URL also works here)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/next

# Required for signed access tokens. Use a long, random value in production.
JWT_SECRET=replace-with-a-long-random-secret

# --- Optional -------------------------------------------------------------
# Node environment: development | production | test
NODE_ENV=development

# Backend port
PORT=3001

# Access token lifetime (vercel/ms syntax)
JWT_EXPIRES_IN=7d

# OpenAI key for commitment extraction. Without it, capture endpoints return 503.
OPENAI_API_KEY=
# Override the extraction / transcription models.
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1
# Per-request timeout and transient-failure retries for the OpenAI calls.
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=2

# Comma-separated list of allowed browser origins. Leave empty to allow all
# (local development default). Set this in production.
FRONTEND_ORIGIN=

# Set to true when running behind a reverse proxy / load balancer.
TRUST_PROXY=false

# Logging: silent | debug | info | warn | error; LOG_PRETTY for human-readable dev logs.
LOG_LEVEL=info
LOG_PRETTY=true

# Rate limiting (disable by setting RATE_LIMIT_ENABLED=false)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=50
RATE_LIMIT_CAPTURE_MAX=60
