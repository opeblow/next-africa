{
  "name": "next-africa",
  "private": true,
  "version": "0.1.0",
  "description": "NEXT Africa — a personal execution copilot",
  "license": "MIT",
  "author": "Mobolaji Opeyemi Bolatito (Developer)",
  "contributors": [
    "Oluwatamilore Paul Olubanwo (Product Manager)"
  ],
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "db:setup": "npm run db:setup -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "npm run db:seed -w backend",
    "verify": "node scripts/verify.mjs",
    "test": "npm test -w backend",
    "test:coverage": "npm run test:coverage -w backend",
    "e2e": "npm run e2e -w frontend",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "lint-staged": {
    "*.{js,jsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "lint-staged": "^17.5.1",
    "pptxgenjs": "^4.0.1",
    "prettier": "^3.9.8"
  }
}
